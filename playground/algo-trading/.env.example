# ──────────────────────────────────────────────────────────────────────────────
# .env.example
#
# Copy this file to .env at the repo root and fill in your keys.
# NEVER commit the actual .env file — it is listed in .gitignore.
#
# This single file is shared by both packages:
#   - packages/quant-engine reads it via pydantic-settings
#   - packages/dashboard reads VITE_* vars via Vite's import.meta.env
# ──────────────────────────────────────────────────────────────────────────────


# ── Trading mode ─────────────────────────────────────────────────────────────
# Options: dev | paper | live
# WARNING: Setting this to "live" will route real orders to your brokerage.
#          Always start with "paper" until you have validated your strategies.
TRADING_MODE=dev


# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (default for dev/backtesting):
DATABASE_URL=sqlite:///./algo_trading.db
# PostgreSQL (recommended for production / paper trading with persistence):
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/algodb


# ── Alpaca (US equities execution + real-time market data) ────────────────────
# Sign up free at https://alpaca.markets
# Use the paper trading keys for TRADING_MODE=paper
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# Paper trading endpoint (default). Switch to https://api.alpaca.markets for live.
ALPACA_BASE_URL=https://paper-api.alpaca.markets


# ── Binance (crypto execution + real-time data) ───────────────────────────────
# Sign up at https://www.binance.com — use testnet keys for dev/paper
# Testnet: https://testnet.binance.vision/
BINANCE_API_KEY=
BINANCE_SECRET_KEY=
# Set to false ONLY when TRADING_MODE=live and using real Binance keys
BINANCE_TESTNET=true


# ── NewsAPI (news headlines) ──────────────────────────────────────────────────
# Sign up free at https://newsapi.org — free tier: 100 requests/day
NEWSAPI_KEY=


# ── Alpha Vantage (fundamental data: P/E, EPS, revenue) ──────────────────────
# Sign up free at https://www.alphavantage.co
# Free tier: 5 requests/min, 500/day
ALPHA_VANTAGE_KEY=


# ── Polygon.io (tick data — optional, for Phase 2 options) ───────────────────
# Sign up at https://polygon.io — free tier available
POLYGON_KEY=


# ── Logging ───────────────────────────────────────────────────────────────────
# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# Set to true to emit logs as JSON (useful for production log aggregation)
LOG_JSON=false


# ── Dashboard (Vite reads VITE_* prefixed vars) ───────────────────────────────
# URL of the quant-engine API server (used by the React dashboard)
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws/feed

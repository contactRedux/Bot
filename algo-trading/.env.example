# ── Mode ─────────────────────────────────────────────────────────────────────
# dev   → PaperBroker in-memory, yfinance data, no external connections needed
# paper → PaperBroker fills, live data from Alpaca/Binance feeds
# live  → Real orders sent to Alpaca (equities) and/or Binance (crypto)
TRADING_MODE=dev

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL — primary database for paper and live trading.
# Create the DB first:  createdb algo_trading
# Or with Docker (using Red Hat UBI image):
#   docker run -d --name algo-pg \
#     -e POSTGRESQL_USER=algo -e POSTGRESQL_PASSWORD=algo \
#     -e POSTGRESQL_DATABASE=algo_trading -p 5432:5432 \
#     registry.redhat.io/rhel9/postgresql-15:latest
DATABASE_URL=postgresql+psycopg2://algo:algo@localhost:5432/algo_trading
# SQLite fallback (no PostgreSQL required):
# DATABASE_URL=sqlite:///./algo_trading.db

# ── Alpaca (US equities — paper and live) ─────────────────────────────────────
# Sign up free at https://alpaca.markets → Paper Trading → API Keys → Generate
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# Paper mode (no real money):
ALPACA_BASE_URL=https://paper-api.alpaca.markets
# Live mode (real orders — switch only when ready):
# ALPACA_BASE_URL=https://api.alpaca.markets

# ── Binance (crypto — testnet and live) ───────────────────────────────────────
# Testnet: https://testnet.binance.vision (free, log in with GitHub)
# Live:    https://www.binance.com → Profile → API Management
BINANCE_API_KEY=
BINANCE_SECRET_KEY=
BINANCE_TESTNET=true

# ── News sentiment feeds ──────────────────────────────────────────────────────
# NewsAPI.org — free tier: 100 req/day
# Sign up at https://newsapi.org → Get API Key
NEWSAPI_KEY=

# Financial Modeling Prep — free tier: 250 req/day
# Best free source for real-time press releases, earnings calendars, SEC filings
# Sign up at https://financialmodelingprep.com/developer/docs
FMP_API_KEY=

# Reddit sentiment (r/wallstreetbets, r/investing, r/stocks)
# Create an app at https://www.reddit.com/prefs/apps → script type
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=
# REDDIT_USER_AGENT=quant-engine/0.1.0

# ── Fundamentals & market data ────────────────────────────────────────────────
# Alpha Vantage — free tier: 5 req/min, 500 req/day
# Sign up at https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_KEY=

# Polygon.io — free tier available, used for tick data
# Sign up at https://polygon.io
POLYGON_KEY=

# ── Bloomberg B-PIPE (institutional — leave blank if unavailable) ─────────────
BLOOMBERG_HOST=localhost
BLOOMBERG_PORT=8194
BLOOMBERG_APP_NAME=

# ── Auth / OIDC ───────────────────────────────────────────────────────────────
# Leave blank in dev — mutation endpoints are open with no auth
# In production set to your Keycloak/Auth0/Google OIDC issuer
OIDC_ISSUER_URL=
OIDC_AUDIENCE=
API_REQUIRED_ROLE=operator

# ── AWS (only needed for cloud deployment via infra/terraform) ────────────────
AWS_SECRETS_PREFIX=algo-trading

# ── Dashboard → API wiring ────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws/feed

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_JSON=false
